<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- PlutoStrap dark palette. Overrides the WPF UI theme colours for a near-black,
         low-contrast-surface look with a single restrained accent. -->
    <Color x:Key="ApplicationBackgroundColor">#FF08080A</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource ApplicationBackgroundColor}" />

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF121216" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF16161B" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FF1A1A20" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FF1C1C23" />
    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="#FF17171C" />
    <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="#FF1C1C22" />

    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF101014" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FF0D0D10" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF212128" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#FF212128" />

    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FF212128" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#FF2A2A33" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#FF212128" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#FF16161B" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#FF1B1B21" />

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFEDEDF2" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF9E9EAB" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF6B6B77" />

    <SolidColorBrush x:Key="NewTextEditorBackground" Color="#FF101014" />
    <SolidColorBrush x:Key="NewTextEditorForeground" Color="#FFEDEDF2" />
    <SolidColorBrush x:Key="NewTextEditorLink" Color="#FF9A8CFF" />
</ResourceDictionary>
