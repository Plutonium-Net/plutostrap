<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- PlutoStrap light palette, mirroring the dark theme's structure and contrast levels. -->
    <Color x:Key="ApplicationBackgroundColor">#FFF7F7F9</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource ApplicationBackgroundColor}" />

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FFF4F4F7" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FFEDEDF1" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="#FFF0F0F3" />
    <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="#FFEAEAEE" />

    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FFFAFAFC" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FFE3E3E9" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#FFE3E3E9" />

    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FFE3E3E9" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#FFD6D6DE" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#FFE3E3E9" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#FFF2F2F5" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#FFEAEAEE" />

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF1A1A1F" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF5A5A66" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF87878F" />

    <SolidColorBrush x:Key="NewTextEditorBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NewTextEditorForeground" Color="#FF1A1A1F" />
    <SolidColorBrush x:Key="NewTextEditorLink" Color="#FF5B4BD6" />
</ResourceDictionary>
