<ui:UiPage x:Class="PlutoStrap.UI.Elements.Settings.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:models="clr-namespace:PlutoStrap.UI.ViewModels.Settings"
      xmlns:resources="clr-namespace:PlutoStrap.Resources"
      d:DataContext="{d:DesignInstance Type=models:HomeViewModel}"
      mc:Ignorable="d"
      d:DesignHeight="640" d:DesignWidth="800"
      Title="HomePage"
      Scrollable="True">

    <StackPanel Margin="0,0,14,14">

        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Width="44" Height="44" VerticalAlignment="Top" Source="pack://application:,,,/PlutoStrap.ico" RenderOptions.BitmapScalingMode="HighQuality" />

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static resources:Strings.Home_Launcher}" FontSize="18" FontWeight="Medium" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Version, Mode=OneTime}" Margin="8,0,0,1" VerticalAlignment="Bottom" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <TextBlock Text="{x:Static resources:Strings.Home_Description}" Style="{StaticResource PlutoStrap.Caption}" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{x:Static resources:Strings.Home_Roblox}" Style="{StaticResource PlutoStrap.SectionHeader}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PlutoStrap.Card}">
                <StackPanel>
                    <TextBlock Text="{x:Static resources:Strings.Home_RobloxPlayer}" Style="{StaticResource PlutoStrap.CardTitle}" />
                    <TextBlock Text="{Binding PlayerStatus, Mode=OneTime}" Style="{StaticResource PlutoStrap.Value}" Margin="0,6,0,0" />
                    <ui:Button Margin="0,14,0,0" HorizontalAlignment="Left" Appearance="Primary" Icon="Play24"
                               Content="{x:Static resources:Strings.Home_Launch}"
                               Command="{Binding LaunchPlayerCommand, Mode=OneTime}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PlutoStrap.Card}">
                <StackPanel>
                    <TextBlock Text="{x:Static resources:Strings.Home_RobloxStudio}" Style="{StaticResource PlutoStrap.CardTitle}" />
                    <TextBlock Text="{Binding StudioStatus, Mode=OneTime}" Style="{StaticResource PlutoStrap.Value}" Margin="0,6,0,0" />
                    <ui:Button Margin="0,14,0,0" HorizontalAlignment="Left" Icon="Play24"
                               Content="{x:Static resources:Strings.Home_Launch}"
                               Command="{Binding LaunchStudioCommand, Mode=OneTime}" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Text="{x:Static resources:Strings.Home_Launcher}" Style="{StaticResource PlutoStrap.SectionHeader}" />

        <Border Style="{StaticResource PlutoStrap.Card}" Margin="0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Static resources:Strings.Home_InstallLocation}" Style="{StaticResource PlutoStrap.Caption}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding InstallLocation, Mode=OneTime}" Style="{StaticResource PlutoStrap.Value}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{x:Static resources:Strings.Home_Launcher_Description}" Style="{StaticResource PlutoStrap.Caption}" Margin="0,8,0,0" />
                <ui:Button Margin="0,12,0,0" HorizontalAlignment="Left" Icon="FolderOpen24"
                           Content="{x:Static resources:Strings.Home_OpenInstallFolder}"
                           Command="{Binding OpenInstallFolderCommand, Mode=OneTime}" />
            </StackPanel>
        </Border>

        <TextBlock Text="{x:Static resources:Strings.Home_Configuration}" Style="{StaticResource PlutoStrap.SectionHeader}" />
        <TextBlock Text="{x:Static resources:Strings.Home_Configuration_Description}" Style="{StaticResource PlutoStrap.Caption}" Margin="0,0,0,8" />

        <WrapPanel Orientation="Horizontal">
            <ui:Button Margin="0,0,8,8" Icon="WrenchScrewdriver20" Content="{x:Static resources:Strings.Menu_Mods_Title}" Command="{Binding OpenModsCommand, Mode=OneTime}" />
            <ui:Button Margin="0,0,8,8" Icon="Flag24" Content="{x:Static resources:Strings.Menu_FastFlags_Title}" Command="{Binding OpenFastFlagsCommand, Mode=OneTime}" />
            <ui:Button Margin="0,0,8,8" Icon="Add28" Content="{x:Static resources:Strings.Menu_Integrations_Title}" Command="{Binding OpenIntegrationsCommand, Mode=OneTime}" />
            <ui:Button Margin="0,0,8,8" Icon="PaintBrush24" Content="{x:Static resources:Strings.Menu_Appearance_Title}" Command="{Binding OpenAppearanceCommand, Mode=OneTime}" />
            <ui:Button Margin="0,0,8,8" Icon="Settings24" Content="{x:Static resources:Strings.Menu_Advanced_Title}" Command="{Binding OpenAdvancedCommand, Mode=OneTime}" />
        </WrapPanel>
    </StackPanel>
</ui:UiPage>
